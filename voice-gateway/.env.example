# Alibaba Cloud Model Studio (Bailian), China / cn-beijing
DASHSCOPE_API_KEY=
QWEN_REALTIME_MODEL=qwen-audio-3.1-realtime-plus
QWEN_REALTIME_URL=wss://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
QWEN_VOICE=longanqian_v3.1
QWEN_TURN_DETECTION=smart_turn
QWEN_MAX_HISTORY_TURNS=10

# Hermes API server
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_SESSION_ID=voice-main
HERMES_SESSION_KEY=agent:main:voice:primary
HERMES_SESSION_ROLLOVER_RUNS=4
HERMES_INLINE_WAIT_SECONDS=2.0
HERMES_POLL_INTERVAL_SECONDS=0.25
HERMES_REQUEST_TIMEOUT_SECONDS=15

# Audio
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_CHUNK_MS=40
AUDIO_MODE=headset

# Logging
LOG_LEVEL=INFO


# Mobile (HarmonyOS/Android) AppServer + control plane
# Generate locally, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
MOBILE_GATEWAY_HOST=0.0.0.0
MOBILE_GATEWAY_PORT=8787
MOBILE_GATEWAY_TOKEN=
# Optional. If blank, derived from QWEN_REALTIME_URL host:
# https://<workspace>.cn-beijing.maas.aliyuncs.com/api/v1/webrtc/realtime?model=qwen-audio-3.1-realtime-plus
QWEN_AOQ_TOKEN_URL=
